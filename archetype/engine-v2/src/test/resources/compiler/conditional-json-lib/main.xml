<archetype-script xmlns="https://helidon.io/archetype/2.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://helidon.io/archetype/2.0 https://helidon.io/xsd/archetype-2.0.xsd">

    <step name="Flavor">
        <inputs>
            <enum id="flavor" name="Flavor" global="true">
                <option value="se" name="SE">
                    <step name="Media">
                        <inputs>
                            <list id="media" name="Media">
                                <option value="json" name="JSON">
                                    <inputs>
                                        <enum id="json-lib"
                                              name="JSON Library">
                                            <option value="jsonp"
                                                    name="JSON-P"/>
                                            <option value="jackson"
                                                    name="Jackson"/>
                                            <option value="jsonb"
                                                    name="JSON-B"/>
                                        </enum>
                                    </inputs>
                                </option>
                                <option value="multipart" name="Multipart"/>
                            </list>
                        </inputs>
                    </step>
                </option>
                <option value="mp" name="MP">
                    <step name="Media">
                        <inputs>
                            <list id="media" name="Media">
                                <option value="json" name="JSON">
                                    <inputs>
                                        <enum id="json-lib"
                                              name="JSON Library">
                                            <option value="jackson"
                                                    name="Jackson"/>
                                            <option value="jsonb"
                                                    name="JSON-B"/>
                                        </enum>
                                    </inputs>
                                </option>
                                <option value="multipart" name="Multipart"/>
                            </list>
                        </inputs>
                    </step>
                </option>
            </enum>
        </inputs>
    </step>

    <step name="Impossible JSONP"
          if="${media} contains 'json' &amp;&amp; ${media.json-lib} == 'jsonp'
              &amp;&amp; ${flavor} != 'se'">
        <inputs>
            <boolean id="never" name="Never"/>
        </inputs>
    </step>

    <step name="JSON-P Only"
          if="${media} contains 'json' &amp;&amp; ${media.json-lib} == 'jsonp'
              &amp;&amp; ${flavor} != 'mp'">
        <inputs>
            <boolean id="jsonp" name="JSON-P"/>
        </inputs>
    </step>

    <step name="JSON Binding"
          if="${media} contains 'json' &amp;&amp; ${media.json-lib} != 'jsonp'
              &amp;&amp; ${flavor} != 'se'">
        <inputs>
            <boolean id="binding" name="Binding"/>
        </inputs>
    </step>
</archetype-script>
