<archetype-script xmlns="https://helidon.io/archetype/2.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://helidon.io/archetype/2.0 https://helidon.io/xsd/archetype-2.0.xsd">

    <step name="Flavor">
        <inputs>
            <enum id="flavor" name="Flavor" global="true">
                <option value="se" name="SE">
                    <step name="Application Type">
                        <inputs>
                            <enum id="app-type" name="App Type" global="true">
                                <option value="quickstart" name="Quickstart">
                                    <presets>
                                        <boolean path="db">false</boolean>
                                    </presets>
                                    <exec src="media.xml"/>
                                </option>
                                <option value="database" name="Database">
                                    <presets>
                                        <boolean path="db">true</boolean>
                                    </presets>
                                    <exec src="media.xml"/>
                                </option>
                                <option value="custom" name="Custom">
                                    <exec src="media.xml"/>
                                    <step name="Database" optional="true">
                                        <inputs>
                                            <boolean id="db"
                                                     name="Database Support"
                                                     default="false"
                                                     optional="true"/>
                                        </inputs>
                                    </step>
                                </option>
                            </enum>
                        </inputs>
                    </step>
                </option>
                <option value="mp" name="MP">
                    <step name="Application Type">
                        <inputs>
                            <enum id="app-type" name="App Type" global="true">
                                <option value="quickstart" name="Quickstart">
                                    <presets>
                                        <boolean path="db">false</boolean>
                                    </presets>
                                    <exec src="media.xml"/>
                                </option>
                                <option value="database" name="Database">
                                    <presets>
                                        <boolean path="db">true</boolean>
                                    </presets>
                                    <exec src="media.xml"/>
                                </option>
                                <option value="custom" name="Custom">
                                    <exec src="media.xml"/>
                                    <step name="Database" optional="true">
                                        <inputs>
                                            <boolean id="db"
                                                     name="Database Support"
                                                     default="false"
                                                     optional="true"/>
                                        </inputs>
                                    </step>
                                </option>
                            </enum>
                        </inputs>
                    </step>
                </option>
            </enum>
        </inputs>
    </step>
</archetype-script>
