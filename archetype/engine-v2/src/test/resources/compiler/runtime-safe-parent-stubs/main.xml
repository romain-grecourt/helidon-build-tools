<archetype-script xmlns="https://helidon.io/archetype/2.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://helidon.io/archetype/2.0 https://helidon.io/xsd/archetype-2.0.xsd">
    <step name="App Type" optional="true">
        <inputs>
            <enum id="app-type" global="true" default="quickstart" optional="true">
                <option value="quickstart"/>
                <option value="custom"/>
            </enum>
        </inputs>
    </step>
    <step name="Features" optional="true" if="${app-type} == 'custom'">
        <inputs>
            <boolean id="metrics" default="false" optional="true">
                <inputs>
                    <boolean id="builtin" default="true" optional="true"/>
                </inputs>
            </boolean>
            <boolean id="health" default="false" optional="true">
                <inputs>
                    <boolean id="builtin" default="true" optional="true"/>
                </inputs>
            </boolean>
            <boolean id="security" default="false" optional="true">
                <inputs>
                    <list id="atz" optional="true">
                        <option value="abac"/>
                    </list>
                </inputs>
            </boolean>
            <boolean id="tracing" default="false" optional="true">
                <inputs>
                    <enum id="provider" default="opentelemetry" optional="true">
                        <option value="opentelemetry"/>
                        <option value="zipkin"/>
                    </enum>
                </inputs>
            </boolean>
        </inputs>
    </step>
    <output>
        <templates engine="mustache">
            <directory>files</directory>
            <includes>
                <include>README.md.mustache</include>
            </includes>
        </templates>
        <model>
            <list key="metrics-dependencies"
                  if="${app-type} == 'custom' &amp;&amp; ${metrics} &amp;&amp; ${metrics.builtin}">
                <value>metrics</value>
            </list>
            <list key="health-dependencies"
                  if="${app-type} == 'custom' &amp;&amp; ${health} &amp;&amp; ${health.builtin}">
                <value>health</value>
            </list>
            <list key="security-dependencies"
                  if="${app-type} == 'custom' &amp;&amp; ${security} &amp;&amp; ${security.atz} contains 'abac'">
                <value>security</value>
            </list>
            <value key="tracing-kind"
                   if="${app-type} == 'custom' &amp;&amp; ${tracing} &amp;&amp; ${tracing.provider} != 'zipkin'">otel</value>
        </model>
    </output>
</archetype-script>
