<archetype-script xmlns="https://helidon.io/archetype/2.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://helidon.io/archetype/2.0 https://helidon.io/xsd/archetype-2.0.xsd">
    <step name="Flavor">
        <inputs>
            <enum id="flavor" name="Flavor" global="true">
                <option name="SE" value="se"/>
                <option name="MP" value="mp"/>
            </enum>
        </inputs>
    </step>
    <step name="Application Type" if="${flavor} != &apos;mp&apos;">
        <inputs>
            <enum id="app-type" name="App Type" global="true">
                <option name="Quickstart" value="quickstart">
                    <presets>
                        <boolean path="~db">false</boolean>
                    </presets>
                    <variables>
                        <text path="~media.default-json-lib">jsonp</text>
                    </variables>
                </option>
                <option name="Database" value="database">
                    <presets>
                        <boolean path="~db">true</boolean>
                    </presets>
                    <variables>
                        <text path="~media.default-json-lib">jsonp</text>
                    </variables>
                </option>
                <option name="Custom" value="custom">
                    <variables>
                        <text path="~media.default-json-lib">jsonp</text>
                    </variables>
                </option>
            </enum>
        </inputs>
    </step>
    <step name="Application Type" if="${flavor} != &apos;se&apos;">
        <inputs>
            <enum id="app-type" name="App Type" global="true">
                <option name="Quickstart" value="quickstart">
                    <presets>
                        <boolean path="~db">false</boolean>
                    </presets>
                    <variables>
                        <text path="~media.default-json-lib">jsonb</text>
                    </variables>
                </option>
                <option name="Database" value="database">
                    <presets>
                        <boolean path="~db">true</boolean>
                    </presets>
                    <variables>
                        <text path="~media.default-json-lib">jsonb</text>
                    </variables>
                </option>
                <option name="Custom" value="custom">
                    <variables>
                        <text path="~media.default-json-lib">jsonb</text>
                    </variables>
                </option>
            </enum>
        </inputs>
    </step>
    <step name="Media Support" optional="true" if="${flavor} != &apos;mp&apos;">
        <inputs>
            <list id="media" name="Media" optional="true" default="json">
                <option name="JSON" value="json">
                    <inputs>
                        <enum id="json-lib"
                              name="JSON Library"
                              default="${default-json-lib}"
                              optional="true">
                            <option name="JSON-P" value="jsonp"/>
                            <option name="Jackson" value="jackson"/>
                            <option name="JSON-B" value="jsonb"/>
                        </enum>
                    </inputs>
                </option>
                <option name="Multipart" value="multipart"/>
            </list>
        </inputs>
        <variables>
            <text path="~media.json-lib" if="!(${media} contains &apos;json&apos;)"/>
        </variables>
    </step>
    <step name="Media Support" optional="true" if="${flavor} != &apos;se&apos;">
        <inputs>
            <list id="media" name="Media" optional="true" default="json">
                <option name="JSON" value="json">
                    <inputs>
                        <enum id="json-lib"
                              name="JSON Library"
                              default="${default-json-lib}"
                              optional="true">
                            <option name="Jackson" value="jackson"/>
                            <option name="JSON-B" value="jsonb"/>
                        </enum>
                    </inputs>
                </option>
                <option name="Multipart" value="multipart"/>
            </list>
        </inputs>
        <variables>
            <text path="~media.json-lib" if="!(${media} contains &apos;json&apos;)"/>
        </variables>
    </step>
    <step name="Database" optional="true" if="${app-type} == &apos;custom&apos;">
        <inputs>
            <boolean id="db" name="Database Support" default="false" optional="true"/>
        </inputs>
    </step>
    <output>
        <transformation id="file-blobs-1">
            <replace regex="\Q3F1B12BB78C7A678F75FFEC589C1DF29\E" replacement="noop.txt"/>
        </transformation>
        <transformation id="file-blobs-2">
            <replace regex="\Q3F1B12BB78C7A678F75FFEC589C1DF29\E" replacement="noop.txt"/>
        </transformation>
        <transformation id="file-blobs-3">
            <replace regex="\Q3F1B12BB78C7A678F75FFEC589C1DF29\E" replacement="noop.txt"/>
        </transformation>
        <files transformations="file-blobs-1">
            <directory>blobs</directory>
            <includes>
                <include if="${app-type} == &apos;custom&apos; &amp;&amp; ${flavor} != &apos;mp&apos; &amp;&amp; ${media} contains &apos;json&apos; &amp;&amp; ${media.json-lib} == &apos;jsonp&apos;">3F1B12BB78C7A678F75FFEC589C1DF29</include>
                <include><![CDATA[]]></include>
            </includes>
        </files>
        <files transformations="file-blobs-2">
            <directory>blobs</directory>
            <includes>
                <include if="${app-type} == &apos;database&apos; &amp;&amp; ${flavor} != &apos;mp&apos; &amp;&amp; ${media} contains &apos;json&apos; &amp;&amp; ${media.json-lib} == &apos;jsonp&apos;">3F1B12BB78C7A678F75FFEC589C1DF29</include>
                <include><![CDATA[]]></include>
            </includes>
        </files>
        <files transformations="file-blobs-3">
            <directory>blobs</directory>
            <includes>
                <include if="${app-type} == &apos;quickstart&apos; &amp;&amp; ${flavor} != &apos;mp&apos; &amp;&amp; ${media} contains &apos;json&apos; &amp;&amp; ${media.json-lib} == &apos;jsonp&apos;">3F1B12BB78C7A678F75FFEC589C1DF29</include>
                <include><![CDATA[]]></include>
            </includes>
        </files>
        <model>
            <list key="imports"
                  if="${app-type} == &apos;quickstart&apos; &amp;&amp; ${flavor} != &apos;mp&apos; &amp;&amp; ${media} contains &apos;json&apos; &amp;&amp; ${media.json-lib} == &apos;jsonp&apos;">
                <value>jakarta.json.JsonObject</value>
            </list>
            <list key="imports"
                  if="${app-type} == &apos;database&apos; &amp;&amp; ${flavor} != &apos;mp&apos; &amp;&amp; ${media} contains &apos;json&apos; &amp;&amp; ${media.json-lib} == &apos;jsonp&apos;">
                <value>jakarta.json.JsonObject</value>
            </list>
            <list key="imports"
                  if="${app-type} == &apos;custom&apos; &amp;&amp; ${flavor} != &apos;mp&apos; &amp;&amp; ${media} contains &apos;json&apos; &amp;&amp; ${media.json-lib} == &apos;jsonp&apos;">
                <value>jakarta.json.JsonObject</value>
            </list>
        </model>
    </output>
</archetype-script>
