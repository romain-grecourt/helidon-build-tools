<archetype-script xmlns="https://helidon.io/archetype/2.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://helidon.io/archetype/2.0 https://helidon.io/xsd/archetype-2.0.xsd">
    <step name="Flags">
        <inputs>
            <boolean id="left" name="Left"/>
            <boolean id="right" name="Right"/>
        </inputs>
    </step>
    <step name="App Type" if="${left} == ${right}">
        <inputs>
            <enum id="app-type" name="App Type" global="true" default="quickstart">
                <option name="Quickstart" value="quickstart"/>
                <option name="Custom" value="custom"/>
            </enum>
        </inputs>
    </step>
    <variables>
        <text path="~app-type"><![CDATA[]]></text>
    </variables>
    <step name="Extras" if="${app-type} != &apos;custom&apos; &amp;&amp; ${left} == ${right}">
        <inputs>
            <list id="extra" name="Extra">
                <option name="Json" value="json"/>
            </list>
        </inputs>
    </step>
    <step name="Extras" if="${app-type} != &apos;quickstart&apos; &amp;&amp; ${left} == ${right}">
        <inputs>
            <list id="extra" name="Extra">
                <option name="Json" value="json"/>
                <option name="Multipart" value="multipart"/>
            </list>
            <boolean id="feature" name="Feature"/>
            <text id="name" name="Name"/>
        </inputs>
    </step>
</archetype-script>
