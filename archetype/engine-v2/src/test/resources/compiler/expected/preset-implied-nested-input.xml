<archetype-script xmlns="https://helidon.io/archetype/2.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://helidon.io/archetype/2.0 https://helidon.io/xsd/archetype-2.0.xsd">
    <step name="App Type" optional="true">
        <inputs>
            <enum id="app-type" name="App Type" global="true" default="quickstart" optional="true">
                <option name="Quickstart" value="quickstart">
                    <presets>
                        <boolean path="~db">false</boolean>
                    </presets>
                </option>
                <option name="Database" value="database">
                    <presets>
                        <boolean path="~db">true</boolean>
                    </presets>
                </option>
                <option name="Custom" value="custom"/>
            </enum>
        </inputs>
    </step>
    <step name="Database" optional="true" if="${app-type} != &apos;quickstart&apos;">
        <inputs>
            <boolean id="db" name="Database Support" default="false" optional="true">
                <inputs>
                    <enum id="server" name="Database Server" default="h2" optional="true">
                        <option name="H2" value="h2"/>
                        <option name="MySQL" value="mysql"/>
                    </enum>
                </inputs>
            </boolean>
        </inputs>
    </step>
    <variables>
        <text path="~db.server"
              if="${app-type} == &apos;quickstart&apos; || ${app-type} == &apos;custom&apos; &amp;&amp; !${db}"><![CDATA[]]></text>
    </variables>
    <step name="Selected Server"
          optional="true"
          if="${db} &amp;&amp; ${db.server} != &apos;mysql&apos;">
        <inputs>
            <text id="summary" name="Summary" default="h2" optional="true"/>
        </inputs>
    </step>
</archetype-script>
